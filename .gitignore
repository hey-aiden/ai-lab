# =====================================================
# ai-lab monorepo 根级 .gitignore
# 统一覆盖 Python / Node.js 两类技术栈与通用项
# =====================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so

# 打包 / 分发
.Python
build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
*.egg
pip-wheel-metadata/
pip-log.txt
pip-delete-this-directory.txt

# 测试 / 覆盖率 / 缓存
.coverage
.coverage.*
.pytest_cache/
.mypy_cache/
.ruff_cache/
.nox/
.tox/
htmlcov/

# 类型检查
.pyre/

# 虚拟环境
.venv/
venv/
env/
ENV/

# ---------- Node.js ----------
node_modules/
.npm/
.pnpm-store/
.yarn/
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
coverage/

# ---------- 环境变量 / 密钥 ----------
.env
.env.*
!.env.example

# ---------- IDE / 编辑器 ----------
.idea/
.vscode/
*.swp
*.swo
*~

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
Desktop.ini

# ---------- 日志 ----------
*.log
