{
  "name": "mcp-weather",
  "version": "1.0.0",
  "description": "Minimal Model Context Protocol (MCP) server example exposing a get-alerts weather tool.",
  "type": "module",
  "main": "./build/index.js",
  "bin": {
    "mcp-weather": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x build/index.js",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node ./build/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "weather"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
